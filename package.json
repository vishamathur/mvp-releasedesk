{
  "name": "mvp-releasedesk",
  "version": "0.1.0",
  "private": true,
  "description": "Release Desk — Northwind Bank KYC demo and future multi-agent release orchestration",
  "license": "GPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @northwind/kyc",
    "build": "npm run build -w @northwind/kyc",
    "build:core": "npm run build -w @releasedesk/core",
    "build:lead": "npm run build -w @releasedesk/lead",
    "build:specialists": "npm run build -w @releasedesk/specialists",
    "start": "npm run start -w @northwind/kyc",
    "test": "npm run test -w @northwind/kyc && npm run test -w @releasedesk/core && npm run test -w @releasedesk/lead && npm run test -w @releasedesk/specialists",
    "test:kyc": "npm run test -w @northwind/kyc",
    "test:core": "npm run test -w @releasedesk/core",
    "test:lead": "npm run test -w @releasedesk/lead",
    "test:specialists": "npm run test -w @releasedesk/specialists",
    "check:release": "npm run check -w @releasedesk/specialists --",
    "check:release:stubs": "npm run check -w @releasedesk/lead --",
    "lint": "npm run lint -w @northwind/kyc",
    "seed": "npm run seed -w @northwind/kyc"
  },
  "engines": {
    "node": ">=20"
  }
}
