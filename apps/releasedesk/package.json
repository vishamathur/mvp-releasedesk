    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^31.0.1",
    "postcss": "^8",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^5.1.1"
