# Release Desk — secret *names* only (NO real values)
# Copy to a local `.env` for developer experiments if needed.
# Production / Cloud Agents / Cursor Apps: configure the SAME names as
# **Cursor named secrets** (Cloud Agent environment Runtime Secrets and/or
# Apps dashboard team/personal secrets). Do NOT use an external vault for MVP.
# Prefer OIDC short-lived tokens where Cursor guidance allows.
# See docs/nhi-cursor-secrets.md
#
# Cloud client mode: MOCK is the CI-safe default (no secrets required).
# RELEASEDESK_CLOUD_CLIENT=mock
# RELEASEDESK_CLOUD_CLIENT=real

# -----------------------------------------------------------------------------
# Per-agent Cursor API key NAMES (NHI) — create as Cursor named secrets
# -----------------------------------------------------------------------------
RELEASEDESK_CURSOR_API_KEY_LEAD=
RELEASEDESK_CURSOR_API_KEY_CHANGE_ANALYST=
RELEASEDESK_CURSOR_API_KEY_STANDARDS=
RELEASEDESK_CURSOR_API_KEY_SECURITY=
RELEASEDESK_CURSOR_API_KEY_BUILDER=
RELEASEDESK_CURSOR_API_KEY_AI_RED_TEAMING=
RELEASEDESK_CURSOR_API_KEY_CODING=
RELEASEDESK_CURSOR_API_KEY_TESTING=
RELEASEDESK_CURSOR_API_KEY_REVIEW=

# Legacy / local-dev shared fallback only (discouraged for NHI tracking).
# Used when a per-agent RELEASEDESK_CURSOR_API_KEY_* slot is unset.
# CURSOR_API_KEY=
# CURSOR_SERVICE_ACCOUNT_KEY=

# -----------------------------------------------------------------------------
# AI Red Teaming provider
# -----------------------------------------------------------------------------
# RELEASEDESK_AI_RED_TEAM_PROVIDER=custom
# RELEASEDESK_AI_RED_TEAM_PROVIDER=zscaler

# Zscaler stub — Cursor named secret (placeholder). No live Zscaler call.
RELEASEDESK_ZSCALER_AI_RED_TEAM_API_KEY=
# Legacy aliases (still recognized by the Zscaler stub):
# ZSCALER_AI_RED_TEAM_API_KEY=
# ZSCALER_AIRT_API_KEY=
# AIGUARD_API_KEY=

# -----------------------------------------------------------------------------
# Optional enrichment / GitHub (unchanged; also prefer Cursor named secrets)
