# Release Desk — exclusive per-agent API keys (SpaceXAI)
#
# RULE: every agent has its own key. Shared XAI_API_KEY / GROK_API_KEY /
# CURSOR_API_KEY / CURSOR_SERVICE_ACCOUNT_KEY are NEVER used as fallbacks.
#
# These keys are for application code (Desk chat completions, specialists,
# Cursor Cloud Agents). Grok Bot app teammates do not take API keys.
# Their ids live in grok-bots/registry.json (grokBotAppAgentId) and must not
# be sent to api.x.ai.
#
# Where to set them (never commit real values):
#   - Local Desk: apps/releasedesk/.env.local  (Next.js reads this, not the repo root)
#   - Cursor Cloud Agents: the same RELEASEDESK_* names as environment secrets
# Copy:  cp .env.example apps/releasedesk/.env.local

# --- Grok Bots + Desk Grok intel (each bot reads only its own key; Lead powers Desk classify/summarize) ---
RELEASEDESK_GROK_API_KEY_LEAD=
RELEASEDESK_GROK_API_KEY_CHANGE_ANALYST=
RELEASEDESK_GROK_API_KEY_STANDARDS=
RELEASEDESK_GROK_API_KEY_SECURITY=
RELEASEDESK_GROK_API_KEY_BUILDER=

# Optional create-client tuning
# RELEASEDESK_GROK_BOT_API_BASE=https://api.x.ai/v1
# RELEASEDESK_GROK_BOT_CREATE_PATH=/agents
# RELEASEDESK_GROK_BOT_DRY_RUN=1

# --- Cursor Cloud Agents (Builder → Coding ships; Testing ∥ Review never merge) ---
RELEASEDESK_CURSOR_API_KEY_CODING=
RELEASEDESK_CURSOR_API_KEY_TESTING=
RELEASEDESK_CURSOR_API_KEY_REVIEW=
RELEASEDESK_CURSOR_API_KEY_LEAD=
RELEASEDESK_CURSOR_API_KEY_BUILDER=

# /handoff reads the Log bot's JSONL from this directory.
RELEASEDESK_LOG_DIR=

# Embedded customer document store (LowDB). Optional.
# Default when unset: packages/releasedesk-core/data/customers.json (gitignored).
# RELEASEDESK_CUSTOMER_DB_PATH=
# Opt-in demo seed of DEMO_PORTFOLIO (Northwind Bank, Contoso Retail, Fabrikam Logistics).
# Store open never seeds. Uncomment only when you want demo customers written.
# RELEASEDESK_SEED_DEMO_CUSTOMERS=1

# --- KYC demo (apps/kyc). Not Desk or Grok keys. Never commit real values. ---
# Next.js reads apps/kyc/.env.local. Copy this block there.
# 32-byte AES-256-GCM key: 64 hex characters or standard base64. Required.
# There is no built-in key. A missing key refuses to read or write the store.
# KYC_DATA_KEY=
# Customer and analyst bearers (min 16 characters, must differ).
# KYC_CUSTOMER_TOKEN=
# KYC_ANALYST_TOKEN=
# Optional actor ids stored as createdBy / decidedBy.
# KYC_CUSTOMER_ACTOR_ID=customer:northwind-demo
# KYC_ANALYST_ACTOR_ID=analyst:northwind-demo
# POST /api/seed. Exact value true, and ignored when NODE_ENV=production.
# KYC_SEED_ENABLED=
# Optional directory for the encrypted store. Default: apps/kyc/data
# KYC_DATA_DIR=
