# Release Desk — exclusive per-agent API keys (SDLC MVP)
#
# RULE: every agent has its own key. Do NOT set shared XAI_API_KEY / GROK_API_KEY /
# CURSOR_API_KEY / CURSOR_SERVICE_ACCOUNT_KEY for the SDLC path — those are ignored
# by resolveAgentGrokApiKey / resolveAgentCursorApiKey and by grokComplete(agentRole).

# --- Grok / xAI (Lead + Change Analyst + Standards + Security + Builder) ---
RELEASEDESK_GROK_API_KEY_LEAD=
RELEASEDESK_GROK_API_KEY_CHANGE_ANALYST=
RELEASEDESK_GROK_API_KEY_STANDARDS=
RELEASEDESK_GROK_API_KEY_SECURITY=
RELEASEDESK_GROK_API_KEY_BUILDER=

# --- Cursor Cloud Agents (Lead / Builder + Coding / Testing / Review) ---
RELEASEDESK_CURSOR_API_KEY_LEAD=
RELEASEDESK_CURSOR_API_KEY_BUILDER=
RELEASEDESK_CURSOR_API_KEY_CODING=
RELEASEDESK_CURSOR_API_KEY_TESTING=
RELEASEDESK_CURSOR_API_KEY_REVIEW=

# Opt-in live Cursor Cloud Agents (default MOCK)
# RELEASEDESK_CLOUD_CLIENT=real

# --- Optional Grok Bot routine webhooks (after create-in-app + setup script) ---
RELEASEDESK_GROK_BOT_WEBHOOK_URL_LEAD=
RELEASEDESK_GROK_BOT_WEBHOOK_KEY_LEAD=
RELEASEDESK_GROK_BOT_WEBHOOK_URL_CHANGE_ANALYST=
RELEASEDESK_GROK_BOT_WEBHOOK_KEY_CHANGE_ANALYST=
RELEASEDESK_GROK_BOT_WEBHOOK_URL_STANDARDS=
RELEASEDESK_GROK_BOT_WEBHOOK_KEY_STANDARDS=
RELEASEDESK_GROK_BOT_WEBHOOK_URL_SECURITY=
RELEASEDESK_GROK_BOT_WEBHOOK_KEY_SECURITY=
RELEASEDESK_GROK_BOT_WEBHOOK_URL_BUILDER=
