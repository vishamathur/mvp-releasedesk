# Release Desk — one app-level Grok API key
#
# Grok Bot teammates do not take API keys. Their ids live in
# grok-bots/registry.json (grokBotAppAgentId) and must not be sent to api.x.ai.
#
# Shipped code (apps/releasedesk/src/lib/grok-release-intel.ts) reads only
# XAI_API_KEY. Per-bot RELEASEDESK_GROK_API_KEY_* and RELEASEDESK_CURSOR_API_KEY_*
# values are ignored. GROK_API_KEY is not a fallback.
#
# Never commit a real value.
# Local Desk: apps/releasedesk/.env.local (Next.js reads this, not the repo root)
# Cursor cloud agent: set XAI_API_KEY as an environment secret.
# Copy: cp .env.example apps/releasedesk/.env.local

XAI_API_KEY=

# Do not set RELEASEDESK_CLOUD_CLIENT=real. Desk does not launch Cursor agents.
# Builder launches the cloud agent from the Grok Bot app.
# RELEASEDESK_CLOUD_CLIENT=mock

# Optional create-script tuning. npm run create:grok-bots does not POST the five app teammates.
# RELEASEDESK_GROK_BOT_API_BASE=https://api.x.ai/v1
# RELEASEDESK_GROK_BOT_CREATE_PATH=/agents
# RELEASEDESK_GROK_BOT_DRY_RUN=1
