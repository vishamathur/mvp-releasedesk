# Zscaler AI Red Teaming — local secrets template (names only; no real credentials)
#
# Copy to .secrets/zscaler-ai-red-teaming.env and fill locally. That file is gitignored.
# Prefer Cursor Apps / Cloud Agent named Runtime Secrets for hosted runs — do not
# commit real values. Without credentials the provider stays MOCK / not_wired.
#
# Related flag: RELEASEDESK_AI_RED_TEAM_PROVIDER=zscaler (default remains custom)

# API endpoint for Zscaler AI Red Teaming / probe service
ZSCALER_AI_RED_TEAM_ENDPOINT=https://example.zscaler.com/api/v1/ai-red-team

# API key or bearer token (prefer Cursor dashboard Runtime Secret of the same name)
ZSCALER_AI_RED_TEAM_API_KEY=

# Scan scope configuration (JSON or comma-separated targets: prompts, models, repos)
ZSCALER_AI_RED_TEAM_SCAN_SCOPE=prompts,models

# Findings routing preference: block | warn | report-only
ZSCALER_AI_RED_TEAM_FINDINGS_ROUTING=report-only
