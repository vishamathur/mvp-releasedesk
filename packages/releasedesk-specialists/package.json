{
  "name": "@releasedesk/specialists",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Specialist Agent runners for Release Desk — Change Analyst, Standards, Security, Builder",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "node --import tsx src/cli.ts"
  },
  "dependencies": {
    "@releasedesk/core": "0.1.0",
    "@releasedesk/lead": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
